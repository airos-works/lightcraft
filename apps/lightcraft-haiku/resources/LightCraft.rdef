resource app_signature "application/x-vnd.jmgasper-LightCraft";
// Preserve this attribute inside the hpkg for Tracker's initial document refs.
resource(2, "BEOS:TYPE") #'MIMS' "application/x-vnd.Be-elfexecutable";
// One copy runs, as the library has one writer: photos opened from Tracker while
// it runs arrive in it as B_REFS_RECEIVED, and a launch from Terminal hands its
// arguments over (B_ARGV_RECEIVED) and ends.
resource app_flags B_SINGLE_LAUNCH;
resource app_version {
    major = 0, middle = 15, minor = 0, variety = B_APPV_DEVELOPMENT, internal = 1,
    short_info = "LightCraft 0.15.0",
    long_info = "LightCraft photo library and RAW developer for air/OS (MIT or Apache-2.0)."
};
resource vector_icon { import "LightCraft.hvif" };
resource file_types message { "types" = "image/png", "types" = "image/jpeg", "types" = "image/tiff", "types" = "image/x-adobe-dng" };
