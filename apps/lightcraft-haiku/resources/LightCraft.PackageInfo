name lightcraft
version 0.15.0~airos1-3
architecture x86_64
summary "Photo library and non-destructive RAW developer"
description "LightCraft for air/OS: the full Rust photo library and non-destructive RAW developer with native windows, file panels and clipboard; Vulkan photo processing and UI rendering on supported hardware, with a CPU fallback."
packager "LightCraft for air/OS"
vendor "jmgasper"
copyrights { "2026 LightCraft contributors" }
licenses { "MIT" "Apache v2" }
urls { "https://github.com/jmgasper/lightcraft" }
provides {
    lightcraft = 0.15.0
    app:LightCraft = 0.15.0
}
requires {
    haiku >= r1~beta6
    lib:libstdc++
    lib:libgcc_s
}
post-install-scripts { "boot/post-install/lightcraft.sh" }
